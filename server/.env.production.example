# 复制为本机受保护的生产配置，再填写独立密钥；不能直接使用占位密码启动。
APP_ENV=production
ALLOW_REGISTRATION=false
ALLOW_PASSWORD_LOGIN=true
ALLOW_SOCIAL_SIGNUP=false
AUTH_PUBLIC_URL=https://desktop.example.com
DESKTOP_OAUTH_CALLBACK_SCHEME=taoscreen
DESKTOP_RELEASE_ORIGIN=
POSTGRES_PASSWORD=REPLACE_WITH_A_NEW_PRODUCTION_DATABASE_PASSWORD
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
ADMIN_AUTH_MODE=local
ADMIN_TOTP_ENABLED=true
# 开启动态码时，用 openssl rand -base64 32 生成 ADMIN_TOTP_KEY
ADMIN_TOTP_KEY=
ADMIN_ACCESS_TEAM_DOMAIN=
ADMIN_ACCESS_AUD=
ADMIN_ALLOWED_EMAILS=
DESKTOP_STUN_URLS=
DESKTOP_TURN_URLS=
DESKTOP_TURN_SECRET=
TRUSTED_PROXY_CIDRS=
CLOUDFLARE_PROXY_CIDRS=
